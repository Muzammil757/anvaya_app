<?xml version="1.0" encoding="utf-8"?>
<!-- ANVAYA native splash: the app's own near-white background (matching
     AppTheme.background) with the real ANVAYA brand mark centered, instead
     of a blank screen — shown while the Android process starts, before
     Flutter's engine draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
